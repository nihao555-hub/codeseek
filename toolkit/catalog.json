      "title": "Context7",
      "description": "按库名拉最新官方文档。可选 CONTEXT7_API_KEY。",
      "transport": "stdio",
      "serverName": "context7",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": { "CONTEXT7_API_KEY": { "from": ["CONTEXT7_API_KEY"] } },
      "enableWhen": { "flag": "MCP_CONTEXT7" },
      "docs": "https://github.com/upstash/context7"
    },
    {
      "id": "stripe",
      "title": "Stripe 官方远程 MCP",
      "description": "客户、产品、支付。演示站不要拿这个当真收款。",
      "transport": "streamable-http",
      "serverName": "stripe",
      "url": "https://mcp.stripe.com",
      "headers": { "Authorization": { "bearer": "STRIPE_SECRET_KEY" } },
      "enableWhen": { "anyEnv": ["STRIPE_SECRET_KEY"], "flag": "MCP_STRIPE" },
      "docs": "https://docs.stripe.com/mcp"
    },
    {
      "id": "linear",
      "title": "Linear 官方远程 MCP",
      "description": "Issue 与项目管理。",
      "transport": "streamable-http",
      "serverName": "linear",
      "url": "https://mcp.linear.app/mcp",
      "headers": { "Authorization": { "bearer": "LINEAR_API_KEY" } },
      "enableWhen": { "anyEnv": ["LINEAR_API_KEY"], "flag": "MCP_LINEAR" },
      "docs": "https://linear.app/docs/mcp"
    },
    {
      "id": "notion",
      "title": "Notion 远程 MCP",
      "description": "页面与数据库。",
      "transport": "streamable-http",
      "serverName": "notion",
      "url": "https://mcp.notion.com/mcp",
      "headers": { "Authorization": { "bearer": "NOTION_TOKEN" } },
      "enableWhen": { "anyEnv": ["NOTION_TOKEN"], "flag": "MCP_NOTION" },
      "docs": "https://developers.notion.com/docs/mcp"
    },
    {
      "id": "sentry",
      "title": "Sentry",
      "description": "错误与 issue。",
      "transport": "stdio",
      "serverName": "sentry",
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": { "SENTRY_ACCESS_TOKEN": { "from": ["SENTRY_AUTH_TOKEN", "SENTRY_ACCESS_TOKEN"] } },
      "enableWhen": { "anyEnv": ["SENTRY_AUTH_TOKEN", "SENTRY_ACCESS_TOKEN"], "flag": "MCP_SENTRY" },
      "docs": "https://github.com/getsentry/sentry-mcp"
    },
    {
      "id": "firecrawl",
      "title": "Firecrawl",
      "description": "把网页爬成干净 markdown。",
      "transport": "stdio",
      "serverName": "firecrawl",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": { "FIRECRAWL_API_KEY": { "from": ["FIRECRAWL_API_KEY"] } },
      "enableWhen": { "anyEnv": ["FIRECRAWL_API_KEY"], "flag": "MCP_FIRECRAWL" },
      "docs": "https://docs.firecrawl.dev/mcp"
    }
  ],
  "communityPlugins": [
    {
      "id": "dsh-mcp-manager",
      "repo": "hyqhyq3/dsh-mcp-manager",
      "title": "MCP 管理页",
      "why": "awesome-dsh-plugin 收录。本仓库已有 codeseek-toolkit-panel，不必再装一套设置页。",
      "install": "不要 dsh plugin add 进 gitignored profile。"
    },
    {
      "id": "dsh-at-file",
      "repo": "omdsh-dev/dsh-at-file",
      "title": "@file 提及",
      "why": "把询盘 PDF / 报价表从输入框贴进会话。awesome-dsh-plugin 收录。本仓库已有 documents MCP，这个是 UI 糖。",
      "install": "审源码后再 overlay；不要 dsh plugin add 进 gitignored profile 就当交付。"
    },
    {
      "id": "dsh-files",
      "repo": "taxueseek/dsh-files",
      "title": "拖文件进会话",
      "why": "询盘附件卡片。读内容优先 mcp__documents__read_document。",
      "install": "dsh plugin --profile web add github:taxueseek/dsh-files"
    },
    {
      "id": "dsh-office-tools",
      "repo": "kw78/dsh-office-tools",
      "title": "Word / Excel / PPT",
      "why": "awesome 上现成的办公轮子。报价数字本仓库用 mcp__trade-crm__quote_catalog，不要两套数。",
      "install": "需要出 xlsx 客户稿时再 overlay。"
    },
    {
      "id": "dsh-cowork",
      "repo": "Jesse-njx/dsh-cowork",
      "title": "单元格读写 xlsx/pdf/docx",
      "why": "awesome 收录。询盘附件精读可复用；日常走 documents MCP。",
      "install": "审 rc.5 兼容后再 overlay。"
    },
    {
      "id": "dsh-tool-csv",
      "repo": "omdsh-dev/dsh-tool-csv",
      "title": "CSV 解析",
      "why": "线索表。本仓库 mcp__trade-crm__export_leads_csv 已覆盖导出。",
      "install": "不必装，除非要解析客户自己丢来的大 CSV。"
    },
    {
      "id": "modlens",
      "repo": "liustack/modlens",
      "title": "看图 OCR",
      "why": "产品图、询盘截图。awesome 收录。预览期可能不兼容 rc.5。",
      "install": "先读仓库 README，再用 overlay，不要改 vendor。"
    },
    {
      "id": "dsh-hud",
      "repo": "a903067276-rgb/dsh-hud",
      "title": "HUD 浮层",
      "why": "awesome 收录。槽位（shell.overlay）已被本仓库 codeseek-activity-panel 复用；不必再装一套 Git/token HUD。",
      "install": "不要 dsh plugin add。右侧看 agent 用本仓库实时面板。"
    },
    {
      "id": "dsh-better-sidebar",
      "repo": "omdsh-dev/DSH-better-sidebar",
      "title": "右侧 IDE 工作台",
      "why": "文件/终端/Git/pty，过重。本产品只要看团员在干什么，不把 DSH 变成 VS Code。",
      "install": "不要装；不要 pnpm approve-builds node-pty。"
    },
    {
      "id": "dsh-task-status",
      "repo": "vlln/dsh-task-status",
      "title": "后台任务条",
      "why": "conversation.input.dock 任务进度。本仓库实时面板已读 runningCalls。",
