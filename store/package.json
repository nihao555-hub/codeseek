{
  "name": "harbor-kiln-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Harbor Kiln 跨境电商独立站：店面 + 结算 API",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.mjs\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
