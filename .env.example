# GRS 中转（OpenAI 兼容）。复制为 .env 后填写，切勿提交真实密钥。
GRS_API_KEY=sk-your-grs-api-key
GRS_BASE_URL=https://grsaiapi.com/v1
# 本地工具代理的上游（不要填 127.0.0.1:18765，否则会打环）
GRS_UPSTREAM_BASE_URL=https://grsaiapi.com/v1

# 国内直连可改为：
# GRS_BASE_URL=https://grsai.dakka.com.cn/v1
# GRS_UPSTREAM_BASE_URL=https://grsai.dakka.com.cn/v1

# 本地工具调用代理
# GRS_TOOL_PROXY_PORT=18765
# 上游失败后最多再试几次（负载过高 / 限流 / 5xx / 超时），默认 3
# GRS_TOOL_PROXY_MAX_RETRIES=3

# 可选：Meta Ads MCP（官方 https://mcp.facebook.com/ads）
# META_ACCESS_TOKEN=EAAB...

# GitHub MCP（stdio 参考服务器 / 官方远程）
# GITHUB_TOKEN=ghp_...
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
# MCP_GITHUB=1
# MCP_GITHUB_OFFICIAL=1

# 无密钥也可开的 MCP（npx/uvx）
# MCP_SEQUENTIAL=1
# MCP_BUYER_DD=1
# MCP_MEMORY=1
# MCP_PLAYWRIGHT=1
# MCP_CONTEXT7=1
# MCP_FETCH=1
# MCP_TIME=1
# MCP_GIT=1
# MCP_SQLITE=1
# MCP_FILESYSTEM=1
# MCP_PUPPETEER=1

# 联网搜索：默认打开本地 web-search MCP（先 SearXNG，失败则 DuckDuckGo）
# 自建 SearXNG：SEARXNG_URL=http://127.0.0.1:8080
# 多个实例用分号分隔。完整 mcp-searxng：npm run toolkit -- enable searxng
# 关闭默认搜索：npm run toolkit -- disable web-search
# SEARXNG_URL=https://searx.tiekoetter.com;https://priv.au
# MCP_WEB_SEARCH=1
# MCP_SEARXNG=1

# 其它 MCP 密钥（有值即自动打开）
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=
# GOOGLE_MAPS_API_KEY=
# POSTGRES_URL=
# STRIPE_SECRET_KEY=
# LINEAR_API_KEY=
# NOTION_TOKEN=
# SENTRY_AUTH_TOKEN=
# CONTEXT7_API_KEY=

# 港窑代发开发信（只发官网核实过的收件人，禁止编造）
# MAIL_FROM=sales@your-domain.com
# RESEND_API_KEY=re_...
# 或者 SMTP：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=sales@your-domain.com
# SMTP_PASS=
# SMTP_SECURE=0

# Web UI 端口
# DSH_PORT=3080

# 本机默认不弹工具审批。更严可改为 workspace-write
# DSH_PERMISSION_MODE=danger-full-access
# 工作区根目录（start.sh 默认指向仓库根）
# DSH_WORKSPACE=/absolute/path/to/codeseek
