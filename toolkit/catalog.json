      "install": "dsh plugin --profile web add github:Han-1413141/dsh-sticky-disclosure"
    },
    {
      "id": "dsh-browser",
      "repo": "Lum1104/dsh-browser",
      "title": "Chrome 侧栏操控浏览器",
      "why": "登录态买家站。不默认装；本产品不登录对方后台群发。",
      "install": "不要为了获客去爬 LinkedIn / 海关付费站。"
    },
    {
