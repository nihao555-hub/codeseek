# GRS 中转（OpenAI 兼容）。复制为 .env 后填写，切勿提交真实密钥。
GRS_API_KEY=sk-your-grs-api-key
GRS_BASE_URL=https://grsaiapi.com/v1
# 本地工具代理的上游（不要填 127.0.0.1:18765，否则会打环）
GRS_UPSTREAM_BASE_URL=https://grsaiapi.com/v1

# 国内直连可改为：
# GRS_BASE_URL=https://grsai.dakka.com.cn/v1
# GRS_UPSTREAM_BASE_URL=https://grsai.dakka.com.cn/v1

# 本地工具调用代理
# GRS_TOOL_PROXY_PORT=18765

# 可选：Meta Ads MCP（官方 https://mcp.facebook.com/ads）
# 用 Graph API Explorer 生成带 ads_read / ads_management 的用户令牌。
# META_ACCESS_TOKEN=EAAB...

# Web UI 端口
# DSH_PORT=3080

# 本机默认不弹工具审批。更严可改为 workspace-write
# DSH_PERMISSION_MODE=danger-full-access
# 工作区根目录（start.sh 默认指向仓库根）
# DSH_WORKSPACE=/absolute/path/to/codeseek
