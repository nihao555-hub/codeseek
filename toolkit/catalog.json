  "mcp": [
    {
      "id": "meta-ads",
      "title": "Meta Ads（官方）",
      "description": "Facebook / Instagram 广告。工具名 mcp__meta-ads__*。新广告保持 PAUSED。",
      "transport": "streamable-http",
      "serverName": "meta-ads",
      "url": "https://mcp.facebook.com/ads",
      "headers": { "Authorization": { "bearer": "META_ACCESS_TOKEN" } },
      "enableWhen": { "anyEnv": ["META_ACCESS_TOKEN"], "flag": "MCP_META_ADS" },
      "docs": "https://mcp.facebook.com/ads"
    },
    {
      "id": "web-search",
      "title": "联网搜索（DuckDuckGo + Wikipedia）",
      "description": "本地 MCP：先 DuckDuckGo，失败再 Wikipedia。公开 SearXNG 默认不打（会 429）。工具名 mcp__web-search__web_search / mcp__web-search__web_fetch。",
      "transport": "stdio",
      "serverName": "web-search",
      "command": "node",
      "args": [{ "js": "(process.env.DSH_WORKSPACE || '/workspace') + '/scripts/web-search-mcp.mjs'" }],
      "env": {
        "SEARXNG_URL": { "from": ["SEARXNG_URL"], "default": "" },
        "SEARXNG_PUBLIC": { "from": ["SEARXNG_PUBLIC"], "default": "" }
      },
      "enableWhen": { "flag": "MCP_WEB_SEARCH" },
      "docs": "https://github.com/searxng/searxng"
    },
    {
      "id": "open-websearch",
      "title": "Open-WebSearch",
      "description": "GitHub 高星无密钥多引擎搜索（Aas-ee/open-webSearch）。本地 NDJSON 包装 CLI，默认 DuckDuckGo，不走 Playwright。工具名 mcp__open-websearch__search。",
      "transport": "stdio",
      "serverName": "open-websearch",
      "command": "node",
      "args": [{ "js": "(process.env.DSH_WORKSPACE || '/workspace') + '/scripts/open-websearch-mcp.mjs'" }],
      "env": {
        "DEFAULT_SEARCH_ENGINE": { "from": ["OPEN_WEBSEARCH_ENGINE"], "default": "duckduckgo" },
        "ALLOWED_SEARCH_ENGINES": { "from": [], "default": "duckduckgo,startpage,bing" },
        "SEARCH_MODE": { "from": [], "default": "request" }
      },
      "enableWhen": { "flag": "MCP_OPEN_WEBSEARCH" },
      "docs": "https://github.com/Aas-ee/open-webSearch"
    },
