{
  "name": "codeseek",
  "private": true,
  "description": "DeepSeek Harness 超级员工：外贸、Meta 广告与开发任务",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "bash scripts/start.sh web",
    "web": "bash scripts/start.sh web",
    "headless": "bash scripts/start.sh headless",
    "doctor": "bash scripts/start.sh doctor",
    "test": "node --test scripts/lib/*.test.mjs store/server/*.test.mjs",
    "toolkit": "node scripts/assemble-toolkit.mjs",
    "toolkit:sync": "node scripts/assemble-toolkit.mjs sync",
    "toolkit:fetch": "node scripts/assemble-toolkit.mjs fetch-skills",
    "probe": "node scripts/probe-tools.mjs",
    "store": "npm --prefix store run dev",
    "store:test": "npm --prefix store test",
    "store:build": "npm --prefix store run build",
    "brand": "bash scripts/apply-brand.sh",
    "postinstall": "git submodule update --init --depth 1 vendor/deepseek-harness || true"
  }
}
