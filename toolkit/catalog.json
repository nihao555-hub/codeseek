      "transport": "stdio",
      "serverName": "buyer-dd",
      "command": "node",
      "args": [{ "js": "(process.env.DSH_WORKSPACE || '/workspace') + '/scripts/buyer-dd-mcp.mjs'" }],
      "enableWhen": { "flag": "MCP_BUYER_DD" },
      "docs": "https://github.com/opencorporates/api-documentation"
